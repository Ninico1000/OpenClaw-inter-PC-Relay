# Neo Relay Client – Konfiguration
# Kopiere diese Datei nach .env und passe die Werte an.

# --- Agent-Loop (WebSocket-Verbindung zum Relay-Server) ---
RELAY_SERVER_URL=ws://server:8765/ws/agent
AGENT_ID=simon-desktop
AGENT_TOKEN=change-me

# --- Voice-Loop (Mikrofon + TTS + OpenClaw) ---
OPENCLAW_URL=http://localhost:18789
OPENCLAW_TOKEN=your-neo-token

# Wake-Word-Modell
# Optionen:
#   hey_neo               – Custom-Modell (muss heruntergeladen sein, siehe README)
#   hey_jarvis            – vorinstalliertes Fallback-Modell
#   /pfad/zur/datei.onnx  – absoluter Pfad zu einem Custom-.onnx-Modell
WAKE_WORD_MODEL=hey_neo

# Whisper-Modell: tiny | base | small | medium | large-v3
# tiny  = schnellste (~75 MB), base = gutes Preis-Leistung (~150 MB)
WHISPER_MODEL=base
WHISPER_LANGUAGE=de

# Piper TTS-Stimme (Pfad zur .onnx-Datei)
# Download: https://rhasspy.github.io/piper-samples/ → de_DE
# Empfohlen: de_DE-thorsten-medium.onnx oder de_DE-kerstin-low.onnx
PIPER_VOICE=/pfad/zu/de_DE-thorsten-medium.onnx

# Mikrofon-Gerät (leer = Standard-Mikrofon)
# Geräte-Liste: python -c "import sounddevice; print(sounddevice.query_devices())"
MIC_DEVICE=

# --- Loops aktivieren/deaktivieren ---
ENABLE_AGENT=true
ENABLE_VOICE=true
