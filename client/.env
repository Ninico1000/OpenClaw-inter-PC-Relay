# Neo Voice Client – Konfiguration
# Kopiere diese Datei nach .env und passe die Werte an

# === Relay Server (wo relay_server.py läuft) ===
RELAY_SERVER_URL=ws://192.168.178.86:8765/ws/agent
AGENT_TOKEN=agent-connect-token

# === Dieser PC ===
AGENT_ID=simon-pc

# === OpenClaw / Neo ===
OPENCLAW_URL=http://192.168.178.86:18789
OPENCLAW_TOKEN=2cfa507e1f80e105df8733f1d52cf7ec333c2126588fb63c

# === Voice-Einstellungen ===
WAKE_WORD_MODEL=hey_neo
WHISPER_MODEL=base
WHISPER_LANGUAGE=de
PIPER_VOICE=piper_voice/de_DE-thorsten-medium.onnx

# Mikro (leer = Standard-Mikro)
MIC_DEVICE=

# Loops (beide true = vollbetrieb)
ENABLE_AGENT=true
ENABLE_VOICE=true

# Logging
LOG_LEVEL=INFO
